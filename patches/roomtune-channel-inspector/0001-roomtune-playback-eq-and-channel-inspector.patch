diff --git a/src/wx/room_eq.h b/src/wx/room_eq.h
new file mode 100644
index 0000000..fe3042c
--- /dev/null
+++ b/src/wx/room_eq.h
@@ -0,0 +1,266 @@
+/*
+    RoomTune — DCP-o-matic 재생 경로 룸튜닝 EQ (소프트웨어 B-chain)
+    DCP-o-matic 파생물 (GPL-2.0-or-later).
+
+    재생(playback) 전용 채널별 biquad EQ.
+    이 처리는 FilmViewer 오디오 콜백에서만 적용되며, 내보내는 DCP에는 영향이 없다.
+
+    필터는 "측정 결과"에서 온다:
+      REW(Room EQ Wizard) 등으로 스피커+룸을 실측하여 타깃 커브(극장 X-curve 등)에
+      맞춘 보정 필터를 뽑고, REW "Filter Settings as text"(= EQ APO) 포맷으로 저장한 뒤
+      아래 경로 중 하나에 두면 플레이어가 재생 시 그 필터를 적용한다:
+        1) 환경변수 ROOMTUNE_EQ_FILE 가 가리키는 파일
+        2) ~/.config/roomtune/room_eq.conf
+      파일이 없거나 유효 밴드가 0개면 EQ 는 무처리(no-op) — 실측 없이는 보정하지 않는다.
+
+    엔진 불변 규칙: 부스트 상한 +6 dB(초과 시 클램프), 컷은 제한 없음,
+    접근성 채널(HI=6, VI=7)은 보정 제외.
+*/
+
+#ifndef DCPOMATIC_ROOM_EQ_H
+#define DCPOMATIC_ROOM_EQ_H
+
+#include "biquad.h"
+#include <atomic>
+#include <cmath>
+#include <vector>
+#include <algorithm>
+#include <cstddef>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sstream>
+#include <fstream>
+
+/** 채널별 RBJ biquad 캐스케이드 EQ.
+ *  process()는 RtAudio 콜백(오디오) 스레드에서 호출되므로 할당/파일 I/O 를 하지 않는다.
+ *  계수·프리앰프는 생성 시 파일에서 1회 로드, on/off 만 atomic 으로 토글한다.
+ */
+class RoomEQ
+{
+public:
+	/** 생성 시 측정 필터 파일을 자동 로드(있으면). 오디오 스트림 fs 는 DCP 표준 48 kHz 가정. */
+	RoomEQ()
+	{
+		load_default();
+	}
+
+	void set_enabled(bool e) { _enabled.store(e, std::memory_order_relaxed); }
+	bool enabled() const { return _enabled.load(std::memory_order_relaxed); }
+
+	/** 실측 필터가 하나라도 로드됐는지 */
+	bool loaded() const { return !_bands.empty(); }
+	std::size_t band_count() const { return _bands.size(); }
+	std::string const& source_path() const { return _source; }
+
+	/** 인터리브 float32, frames x channels, DCP 채널 순서(0=L,1=R,2=C,3=LFE,4=Ls,5=Rs,...). */
+	void process(float* io, unsigned int frames, unsigned int channels)
+	{
+		if (!_enabled.load(std::memory_order_relaxed) || channels == 0 || _bands.empty()) {
+			return;
+		}
+		unsigned int const cn = std::min<unsigned int>(channels, MAX_CH);
+		unsigned int const bn = std::min<unsigned int>(static_cast<unsigned int>(_bands.size()), MAX_BANDS);
+		double const pre = _preamp;
+		for (unsigned int f = 0; f < frames; ++f) {
+			float* fr = io + static_cast<std::size_t>(f) * channels;
+			for (unsigned int c = 0; c < cn; ++c) {
+				/* HI(6)/VI(7) 접근성 채널은 룸 보정 대상에서 제외 */
+				if (c == 6 || c == 7) {
+					continue;
+				}
+				double x = fr[c] * pre;
+				for (unsigned int b = 0; b < bn; ++b) {
+					x = _bands[b].process(_state[c][b], x);
+				}
+				fr[c] = static_cast<float>(x);
+			}
+		}
+	}
+
+	/** REW/EQ-APO 파라메트릭 텍스트 파일에서 필터를 로드. 성공 시 true. */
+	bool load_file(std::string const& path)
+	{
+		std::ifstream in(path);
+		if (!in) {
+			return false;
+		}
+		double const fs = SAMPLE_RATE;
+		std::vector<Biquad> bands;
+		double preamp_db = 0.0;
+		std::string line;
+		unsigned int clamped = 0;
+		while (std::getline(in, line)) {
+			std::string const l = trim(line);
+			if (l.empty() || l[0] == '#' || l[0] == '*') {
+				continue;
+			}
+			/* Preamp: -6.0 dB */
+			if (istarts_with(l, "Preamp")) {
+				double v;
+				if (find_after(l, "Preamp", v) || find_number(l, v)) {
+					preamp_db = v;
+				}
+				continue;
+			}
+			/* Filter N: ON PK Fc 63.0 Hz Gain -5.0 dB Q 4.000 */
+			if (!istarts_with(l, "Filter")) {
+				continue;
+			}
+			std::vector<std::string> tok = split_ws(l);
+			/* "ON" 이 없으면(=OFF/None) 건너뜀 */
+			int on_idx = index_of_ci(tok, "ON");
+			if (on_idx < 0 || on_idx + 1 >= static_cast<int>(tok.size())) {
+				continue;
+			}
+			std::string type = upper(tok[on_idx + 1]);
+			if (type == "NONE") {
+				continue;
+			}
+			double fc = 0, gain = 0, q = 0;
+			bool has_fc = find_after(l, "Fc", fc);
+			bool has_gain = find_after(l, "Gain", gain);
+			bool has_q = find_after(l, "Q", q);
+			if (!has_fc || fc <= 0 || fc >= fs / 2) {
+				continue;  /* 나이퀴스트 밖이거나 Fc 없음 → 스킵 */
+			}
+			/* 엔진 규칙: 부스트 상한 +6 dB */
+			if (has_gain && gain > MAX_BOOST_DB) {
+				gain = MAX_BOOST_DB;
+				++clamped;
+			}
+			Biquad bq;
+			bool ok = true;
+			if (type == "PK" || type == "PEQ" || type == "MODAL") {
+				if (!has_q || q <= 0) q = 1.0;
+				bq = roomtune::peaking(fc, q, gain, fs);
+			} else if (type == "LS" || type == "LSC" || type == "LOWSHELF") {
+				if (!has_q || q <= 0) q = 0.707;
+				bq = roomtune::shelf(fc, q, gain, fs, /*low=*/true);
+			} else if (type == "HS" || type == "HSC" || type == "HIGHSHELF") {
+				if (!has_q || q <= 0) q = 0.707;
+				bq = roomtune::shelf(fc, q, gain, fs, /*low=*/false);
+			} else if (type == "LP" || type == "LPQ" || type == "LOWPASS") {
+				if (!has_q || q <= 0) q = 0.707;
+				bq = roomtune::pass(fc, q, fs, /*low=*/true);
+			} else if (type == "HP" || type == "HPQ" || type == "HIGHPASS") {
+				if (!has_q || q <= 0) q = 0.707;
+				bq = roomtune::pass(fc, q, fs, /*low=*/false);
+			} else {
+				ok = false;  /* 미지원 타입(AP, BP 등) */
+			}
+			if (ok && bands.size() < MAX_BANDS) {
+				bands.push_back(bq);
+			}
+		}
+		if (bands.empty() && preamp_db == 0.0) {
+			return false;  /* 파일은 있으나 쓸 밴드 없음 */
+		}
+		/* 프리앰프는 부스트 방지 목적이라 통상 음수. 안전상 +0 dB 로 상한(감쇠만 허용) */
+		double const pdb = std::min(preamp_db, 0.0);
+		_bands = std::move(bands);
+		_preamp = std::pow(10.0, pdb / 20.0);
+		_source = path;
+		std::fprintf(stderr, "[RoomEQ] loaded %zu band(s), preamp %.1f dB from %s%s\n",
+		             _bands.size(), pdb, path.c_str(),
+		             clamped ? " (일부 게인 +6dB 로 클램프됨)" : "");
+		return true;
+	}
+
+private:
+	static unsigned int const MAX_CH = 16;
+	static std::size_t const MAX_BANDS = 32;
+	static constexpr double SAMPLE_RATE = 48000.0;  /* DCP 오디오 표준 */
+	static constexpr double MAX_BOOST_DB = 6.0;     /* 엔진 규칙: 부스트 상한 */
+
+	/* DSP 코어(Biquad/State/peaking/shelf/pass)는 biquad.h 공유(roomtune::).
+	   channel_inspector.h 와 동일 코어를 쓴다. 아래 alias 로 기존 코드 무변경. */
+	using Biquad = roomtune::Biquad;
+	using State = roomtune::BiquadState;
+
+	void load_default()
+	{
+		if (char const* env = std::getenv("ROOMTUNE_EQ_FILE")) {
+			if (env[0] && load_file(env)) {
+				return;
+			}
+		}
+		if (char const* home = std::getenv("HOME")) {
+			if (load_file(std::string(home) + "/.config/roomtune/room_eq.conf")) {
+				return;
+			}
+		}
+		/* 실측 파일 없음 → 무처리로 남는다(가짜 데모 없음) */
+	}
+
+	/* ---- 파싱 헬퍼(모두 생성 스레드 전용) ---- */
+	static std::string trim(std::string s) {
+		std::size_t a = s.find_first_not_of(" \t\r\n");
+		std::size_t b = s.find_last_not_of(" \t\r\n");
+		return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+	}
+	static std::string upper(std::string s) {
+		for (auto& c : s) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+		return s;
+	}
+	static bool istarts_with(std::string const& s, char const* p) {
+		std::size_t n = std::strlen(p);
+		if (s.size() < n) return false;
+		for (std::size_t i = 0; i < n; ++i) {
+			if (std::toupper(static_cast<unsigned char>(s[i])) != std::toupper(static_cast<unsigned char>(p[i]))) return false;
+		}
+		return true;
+	}
+	static std::vector<std::string> split_ws(std::string const& s) {
+		std::vector<std::string> out;
+		std::istringstream is(s);
+		std::string t;
+		while (is >> t) out.push_back(t);
+		return out;
+	}
+	static int index_of_ci(std::vector<std::string> const& v, char const* w) {
+		for (int i = 0; i < static_cast<int>(v.size()); ++i) {
+			if (upper(v[i]) == upper(std::string(w))) return i;
+		}
+		return -1;
+	}
+	static bool parse_double(std::string const& s, double& out) {
+		char* end = nullptr;
+		double v = std::strtod(s.c_str(), &end);
+		if (end == s.c_str()) return false;
+		out = v;
+		return true;
+	}
+	/* 키워드(예: "Fc") 바로 뒤에 오는 첫 숫자 토큰을 읽는다. */
+	static bool find_after(std::string const& line, char const* key, double& out) {
+		std::vector<std::string> tok = split_ws(line);
+		std::string const K = upper(std::string(key));
+		for (std::size_t i = 0; i + 1 < tok.size(); ++i) {
+			/* "Fc" 또는 "Fc:" 등 접두 일치 */
+			std::string t = upper(tok[i]);
+			if (t == K || t == K + ":") {
+				for (std::size_t j = i + 1; j < tok.size(); ++j) {
+					double v;
+					if (parse_double(tok[j], v)) { out = v; return true; }
+				}
+			}
+		}
+		return false;
+	}
+	/* 라인 안 첫 숫자 */
+	static bool find_number(std::string const& line, double& out) {
+		for (auto const& t : split_ws(line)) {
+			if (parse_double(t, out)) return true;
+		}
+		return false;
+	}
+
+	std::vector<Biquad> _bands;
+	double _preamp = 1.0;
+	std::string _source;
+	State _state[MAX_CH][MAX_BANDS];
+	std::atomic<bool> _enabled{false};
+};
